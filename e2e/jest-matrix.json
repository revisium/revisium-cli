{
  "verbose": true,
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "e2e/matrix/.*.e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 600000,
  "moduleDirectories": ["node_modules", "<rootDir>"],
  "modulePaths": ["<rootDir>"],
  "maxWorkers": 1
}
